# Copy to .env if you want to override the defaults.
# The service runs without this file.

NASA_POWER_BASE_URL=https://power.larc.nasa.gov/api/temporal/daily/point
NASA_POWER_COMMUNITY=AG
NASA_POWER_TIME_STANDARD=LST
NASA_POWER_TIMEOUT_SECONDS=60
NASA_POWER_MAX_RETRIES=3
HTTP_CONNECT_TIMEOUT_SECONDS=10
RETRY_BASE_SECONDS=0.5
RETRY_MAX_SECONDS=8

# Nominatim requires an identifying User-Agent. Replace this with your app name
# and a contact email before sharing or deploying the service.
GEOCODING_BASE_URL=https://nominatim.openstreetmap.org/search
GEOCODING_USER_AGENT=NASA-Space-Apps-Climate-Service/0.1 (local educational use; you@example.com)
GEOCODING_MIN_INTERVAL_SECONDS=1.1
GEOCODING_TIMEOUT_SECONDS=20
GEOCODING_MAX_RETRIES=2

HTTP_USER_AGENT=NASA-Space-Apps-Climate-Service/0.1 (NASA Space Apps Challenge; local)

# Public NASA CMR catalogue used to find SMAP granules. No Earthdata password is required.
SMAP_CMR_URL=https://cmr.earthdata.nasa.gov/search/granules.json
SMAP_PAGE_SIZE=20
SMAP_MAX_DATE_RANGE_DAYS=366
SMAP_EARLIEST_DATE=2015-03-31

# Google Earth Engine NASA SMAP L4 Integration
GEE_PROJECT_ID=fieldshift-514709
SMAP_L4_GEE_DATASET=NASA/SMAP/SPL4SMGP/008
SMAP_GEE_SCALE=11000

CACHE_DIR=data
HOT_DAY_THRESHOLD_C=30
COLD_DAY_THRESHOLD_C=5
DRY_DAY_PRECIPITATION_MM=1.0
MAX_DATE_RANGE_DAYS=3660
EARLIEST_DATE=1981-01-01
